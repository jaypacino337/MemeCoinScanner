# ---------------------------------------------------------------------------
# Viral Coin Radar — environment configuration
#
# Copy to .env and fill in. Only DATABASE_URL is genuinely required; the app
# boots and is fully navigable without any platform credential, serving clearly
# labelled demo fixtures instead.
#
# See docs/DATA_SOURCES.md for what each integration actually requires.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://radar:radar@localhost:5432/viral_coin_radar?schema=public"

# --- Core behaviour ---------------------------------------------------------
NODE_ENV="development"

# "fixture" — always serve bundled synthetic demo data (default, no creds needed)
# "live"    — use HTTP adapters wherever credentials exist; fixtures elsewhere
DATA_MODE="fixture"

# Shared secret for POST /api/cron/scan and POST /api/cron/worker.
# Send as: Authorization: Bearer <value>
CRON_SECRET="change-me-to-a-long-random-string"

# --- Platform data sources --------------------------------------------------
# IMPORTANT: none of TikTok, Instagram, or X offers a public endpoint that
# returns "currently viral posts with view counts". Each *_API_BASE_URL below
# points at whichever access route you are licensed to use — an official
# developer programme or a permitted third-party data provider — behind the
# response contract documented in docs/DATA_SOURCES.md.
#
# Leave any of these unset and that platform keeps serving labelled fixtures
# and reports CREDENTIALS_MISSING on the Settings page.

# TikTok — sent as: x-api-key: <key>
# TIKTOK_API_BASE_URL="https://your-provider.example.com/tiktok/v1"
# TIKTOK_API_KEY=""

# Instagram — sent as: x-api-key: <key>
# INSTAGRAM_API_BASE_URL="https://your-provider.example.com/instagram/v1"
# INSTAGRAM_API_KEY=""

# X — sent as: Authorization: Bearer <token>
# X_API_BASE_URL="https://your-provider.example.com/x/v1"
# X_BEARER_TOKEN=""

# --- Pump.fun duplicate screening -------------------------------------------
# A Pump.fun-compatible search/index endpoint. Without it, screening runs
# against the bundled synthetic index and says so in the UI.
# PUMPFUN_API_BASE_URL="https://your-index.example.com/v1"
# PUMPFUN_API_KEY=""

# --- Tunables ---------------------------------------------------------------
HTTP_TIMEOUT_MS="8000"
CACHE_TTL_SECONDS="300"
RATE_LIMIT_PER_MINUTE="60"
LOG_LEVEL="info"

# Resolve every candidate URL over the network before displaying it.
# Set "false" for offline or CI environments; results then show as Unverified.
ENABLE_LINK_VERIFICATION="true"
